# ──────────────────────────────────────────────────────────────────────────
# Bol Chaal — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. Only NEXT_PUBLIC_* vars reach the browser;
# everything else is server-only and must stay secret.
# ──────────────────────────────────────────────────────────────────────────

# ── Phase 0: Supabase (auth + database) ───────────────────────────────────
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used later for admin tasks (leagues, cron). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the app (used for auth redirects + OG images).
# Local dev: http://localhost:3000  ·  Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Phase 1: AI tutor (Anthropic / Claude) — server-only ──────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional. Defaults to claude-opus-4-8 (most capable). For faster/cheaper
# turns you can set claude-sonnet-4-6 or claude-haiku-4-5.
# ANTHROPIC_MODEL=claude-opus-4-8

# ── Phase 3: Voice (Azure Cognitive Services Speech) — server-only ────────
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=your-azure-region   # e.g. eastus
