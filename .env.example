# ─────────────────────────────────────────────────────────────────────────────
# Bright Stars social automation — secrets template
# Copy to `.env` for local use, or add each as a GitHub Actions secret.
# NEVER commit the real .env. See docs/SETUP.md for how to obtain each value.
# ─────────────────────────────────────────────────────────────────────────────

# Claude API — content generation (required for `generate`)
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-opus-4-8
BRIGHTSTARS_MODEL=claude-opus-4-8

# ── Meta (Facebook Page + Instagram) — required for publishing to FB/IG ────────
# Facebook Page numeric ID
META_PAGE_ID=
# Long-lived Page access token (see docs/SETUP.md → Meta)
META_PAGE_ACCESS_TOKEN=
# Instagram *Business* account user id (linked to the Page)
META_IG_USER_ID=
# Graph API version
META_GRAPH_VERSION=v21.0

# ── LinkedIn (hiring posts only) — required for publishing to LinkedIn ──────────
# Organization URN, e.g. urn:li:organization:1234567
LINKEDIN_ORG_URN=
# Access token with w_organization_social scope
LINKEDIN_ACCESS_TOKEN=
